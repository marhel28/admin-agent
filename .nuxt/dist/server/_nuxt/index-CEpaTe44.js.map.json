{"file":"index-CEpaTe44.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAeqB,QAAwB,IAAI;AAEjD,UAAM,UAAU,IAAI,IAAI;;;AAhBjB,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,0EAAsE,MAAA,CAAA,CAAA,GAAA;UACpE,QAAA,OAAO;;;UACV,MAAK;AAAA,UAAuB,OAAM;AAAA,QAAA;;;;;;;;;;;;;;;;;;;ACmK9C,mBAAe,gBAAgB,CAAC,kBAAkB,CAAC;AAKnD,QAAI,CAAC,gBAAgB,WAAW,UAAU,eAAe,kBAAkB,eAAe,CAAC;AAE3F,UAAM,UAAU,IAAI,IAAI;AAExB,UAAM,QAAQ,IAAI;AAAA,MAClB,gBAAgB;AAAA,MAChB,aAAa;AAAA,MACb,YAAY;AAAA,MACZ,mBAAmB;AAAA,MACnB,cAAc;AAAA,IAAA,CACb;AAED,UAAM,aAAa,IAAI,EAAE,OAAO,CAAA,GAAI,QAAQ,CAAA,GAAI;AAChD,UAAM,eAAe,IAAI,EAAE;AAG3B,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,aAAa,IAAI,EAAE;AAEzB,UAAM,UAAU,IAAI;AAAA,MACpB;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,QAAQ;AAAA,QACR,UAAU;AAAA,QACV,cAAc,CAAC,MAAM;AACnB,gBAAM,YAAY,EAAE,SAAS,KAAK,UAAU,GAAG,CAAC,EAAE,YAAA;AAClD,gBAAM,OAAO,EAAE,SAAS;AACxB,gBAAM,WAAW,EAAE,KAAK,SAAS;AAGjC,gBAAM,UAAU,EAAE,KAAK,gBACnB,aAAa,EAAE,KAAK,aAAa,uJACjC,sSAAsS,QAAQ;AAElT,iBAAO;AAAA,gBACK,OAAO;AAAA;AAAA,mFAE4D,IAAI;AAAA,mFACJ,QAAQ;AAAA;AAAA;AAAA,QAGzF;AAAA,MAAA;AAAA,MAEF;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,QAAQ;AAAA,QACR,UAAU;AAAA,QACV,cAAc,CAAC,MAAM;AACnB,iBAAO;AAAA;AAAA,gBAEK,EAAE,SAAS,KAAK;AAAA;AAAA,QAE9B;AAAA,MAAA;AAAA,MAEF;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,QAAQ;AAAA,QACR,UAAU;AAAA,QACV,cAAc,CAAC,MAAM;AACnB,cAAI,CAAC,EAAE,MAAO,QAAO;AACrB,iBAAO;AAAA;AAAA,kBAEO,EAAE,KAAK;AAAA;AAAA;AAAA,QAGvB;AAAA,MAAA;AAAA,MAEF;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,UAAU;AAAA,QACV,cAAc,CAAC,MAAM;AAGA,YAAE,UAAU,QAAQ,EAAE,KAAK,WAAW,YAAY;AACrD;AACd,mBAAO;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,UAMT;AAAA,QAOF;AAAA,MAAA;AAAA,MAEF;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,cAAc,CAAC,MAAM;AACnB,cAAI,CAAC,EAAE,MAAO,QAAO;AACrB,iBAAO;AAAA;AAAA;AAAA;AAAA,gBAIK,EAAE,KAAK;AAAA;AAAA,QAErB;AAAA,MAAA;AAAA,MAEF;AAAA,QACE,OAAO;AAAA,QACP,YAAY;AAAA,QACZ,MAAM;AAAA,QACN,UAAU;AAAA,QACV,QAAQ;AAAA,QACR,cAAc,CAAC,MAAM;AACnB,iBAAO;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,QAOT;AAAA,MAAA;AAAA,IACF,CACC;AAED,UAAM,gBAAgB,IAAI;AAAA,MAC1B,WAAW;AAAA,MACX,UAAU;AAAA,IAAA,CACT;AAED,UAAM,eAAe,CAAC,UAAkB;AACxC,UAAI,SAAS,IAAS,QAAO,OAAO,QAAQ,KAAS,QAAQ,CAAC,CAAC;AAC/D,aAAO,MAAM,MAAM,eAAe,OAAO,CAAC;AAAA,IAC1C;AA8BA,UAAM,eAAe,SAAS,MAAM;AACpC,UAAI,CAAC,WAAW,MAAM,MAAM,OAAQ,QAAO;AAC3C,aAAO;AAAA,QACL,SAAS,EAAE,SAAS,QAAQ,iBAAiB,yBAAyB,WAAW,EAAE,OAAO,UAAA,GAAa,aAAa,GAAG,YAAY,IAAI,aAAa,kBAAA;AAAA,QACpJ,MAAM,EAAE,MAAM,IAAI,OAAO,IAAI,KAAK,IAAI,QAAQ,GAAG,cAAc,MAAA;AAAA,QAC/D,OAAO,EAAE,MAAM,YAAY,aAAa,OAAO,MAAM,WAAW,MAAM,OAAO,MAAM,MAAA;AAAA,QACnF,OAAO,EAAE,MAAM,SAAS,MAAM,MAAA;AAAA,QAC9B,QAAQ;AAAA,UACN;AAAA,YACE,MAAM;AAAA,YACN,MAAM;AAAA,YACN,QAAQ;AAAA,YACR,YAAY;AAAA,YACZ,MAAM,WAAW,MAAM;AAAA,YACvB,WAAW,EAAE,OAAO,UAAA;AAAA,YACpB,WAAW,EAAE,OAAO,GAAG,aAAa,wBAAwB,YAAY,GAAA;AAAA,YACxE,WAAW;AAAA,cACT,OAAO;AAAA,gBACL,MAAM;AAAA,gBAAU,GAAG;AAAA,gBAAG,GAAG;AAAA,gBAAG,IAAI;AAAA,gBAAG,IAAI;AAAA,gBACvC,YAAY,CAAC,EAAE,QAAQ,GAAG,OAAO,YAAA,GAAe,EAAE,QAAQ,GAAG,OAAO,aAAa;AAAA,cAAA;AAAA,YACnF;AAAA,UACF;AAAA,QACF;AAAA,MACF;AAAA,IAEF,CAAC;AAED,UAAM,iBAAiB,SAAS,MAAM;AACtC,UAAI,CAAC,aAAa,MAAM,OAAQ,QAAO;AACvC,aAAO;AAAA,QACL,SAAS,EAAE,SAAS,QAAQ,iBAAiB,yBAAyB,WAAW,EAAE,OAAO,UAAA,GAAa,aAAa,GAAG,YAAY,IAAI,aAAa,kBAAA;AAAA,QACpJ,QAAQ;AAAA,UACN;AAAA,YACE,MAAM;AAAA,YACN,QAAQ,CAAC,OAAO,KAAK;AAAA,YACrB,QAAQ,CAAC,OAAO,KAAK;AAAA,YACrB,mBAAmB;AAAA,YACnB,WAAW,EAAE,cAAc,GAAG,aAAa,QAAQ,aAAa,EAAA;AAAA,YAChE,OAAO,EAAE,MAAM,MAAA;AAAA,YACf,MAAM,aAAa;AAAA,UAAA;AAAA,QACrB;AAAA,MACF;AAAA,IAEF,CAAC;;;;;mBA7XMD,eAAAC,WAAA,EAAA,OAAM,qCAAiC,MAAA,CAAA,kLAIS,EAAA,SAAA,kBAA8B,6UAK3E,EAAA,cAAA,+DAAA,CAAiF;;QAC3E,MAAK;AAAA,QAAiB,OAAM;AAAA,MAAA;;;QAI5B,MAAK;AAAA,QAAuB,OAAK,CAAC,WAAS,EAAA,gBAA2B,QAAA,OAAO;AAAA,MAAA;;UAO9E,QAAA,SAAO,CAAK,MAAA,MAAM,gBAAc;;;UACnC,MAAK;AAAA,UAAuB,OAAM;AAAA,QAAA;;;;;UAW5B,MAAK;AAAA,UAAgC,OAAM;AAAA,QAAA;sFAEA,MAAA,MAAM,eAAe,eAAc,OAAA,CAAA,CAAA,uFAAA;;UAE9E,MAAK;AAAA,UAA8B,OAAM;AAAA,QAAA;;;UASzC,MAAK;AAAA,UAAkB,OAAM;AAAA,QAAA;sFAEc,MAAA,MAAM,YAAY,eAAc,OAAA,CAAA,CAAA,uFAAA;;UAE3E,MAAK;AAAA,UAA8B,OAAM;AAAA,QAAA;;;UASzC,MAAK;AAAA,UAAsB,OAAM;AAAA,QAAA;sFAEU,aAAa,MAAA,MAAM,gBAAY,CAAA,CAAA,CAAA,uFAAA;;UAE1E,MAAK;AAAA,UAAsB,OAAM;AAAA,QAAA;;;UASjC,MAAK;AAAA,UAA0B,OAAM;AAAA,QAAA;uFAEO,MAAA,MAAM,qBAAiB,GAAO,eAAc,OAAA,CAAA,CAAA,qFAAA;;UAExF,MAAK;AAAA,UAAiB,OAAM;AAAA,QAAA;;;UAcxB,IAAG;AAAA,UAAiB,OAAM;AAAA,QAAA;2BAApC,CAAkL,GAAAC,QAAAC,UAAA,aAAA;;;;;gCAA5B,cAAiB;AAAA,cAAA;AAAA;;;;;;;YAYzJ,aAAA,OAAY;;YAAG,QAAQ,aAAA;AAAA,YAAc,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;YAMtD,eAAA,OAAc;;YAAG,QAAQ,eAAA;AAAA,YAAgB,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;;UAclE,MAAK;AAAA,UAA6B,OAAM;AAAA,QAAA;0DAClB,WAAA,KAAU,CAAA,mVAAA;;UAGhC,MAAK;AAAA,UAAmB,OAAM;AAAA,QAAA;;;UAQtC,OAAM;AAAA,UACL,YAAY,QAAA;AAAA,UACZ,SAAS,SAAA;AAAA,UACT,eAAe,cAAA;AAAA,UACf,YAAY;AAAA,UACZ,oBAAoB;AAAA,UACpB,iBAAiB,WAAA;AAAA,UACjB,aAAa;AAAA,UACd,cAAa;AAAA,UACZ,WAAW;AAAA,UACX,cAAc;AAAA,QAAA;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent"],"sources":["../../../../components/MiniMap.vue","../../../../pages/index.vue"],"sourcesContent":["<template>\n  <div class=\"w-full h-full relative rounded-xl overflow-hidden bg-slate-50 border\">\n    <div v-if=\"loading\" class=\"absolute inset-0 bg-white/80 flex items-center justify-center z-10\">\n      <Icon name=\"heroicons:arrow-path\" class=\"w-6 h-6 animate-spin text-slate-400\" />\n    </div>\n    <div ref=\"mapContainer\" class=\"w-full h-full min-h-[300px]\"></div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, onMounted, onUnmounted } from 'vue'\nimport { api } from '~/utils/api'\nimport maplibregl from 'maplibre-gl'\nimport 'maplibre-gl/dist/maplibre-gl.css'\n\nconst mapContainer = ref<HTMLElement | null>(null)\nlet map: maplibregl.Map | null = null\nconst loading = ref(true)\n\nconst initMap = async () => {\n  if (!mapContainer.value) return\n\n  map = new maplibregl.Map({\n    container: mapContainer.value,\n    style: {\n      version: 8,\n      sources: {\n        'carto-dark': {\n          type: 'raster',\n          tiles: [\n            'https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png'\n          ],\n          tileSize: 256,\n          attribution: '&copy; OpenStreetMap, &copy; CARTO'\n        }\n      },\n      layers: [\n        {\n          id: 'carto-dark-layer',\n          type: 'raster',\n          source: 'carto-dark',\n          minzoom: 0,\n          maxzoom: 19\n        }\n      ]\n    },\n    center: [106.827153, -6.175110], // Default center (Jakarta)\n    zoom: 4,\n    scrollZoom: false\n  })\n\n  map.on('load', async () => {\n    try {\n      const merchants = await api.get('/admin/analytics/merchants-map')\n      if (merchants && merchants.length > 0) {\n        \n        // Add markers\n        const bounds = new maplibregl.LngLatBounds()\n        let hasValidCoords = false\n\n        merchants.forEach((m: any) => {\n          if (m.longitude && m.latitude) {\n            hasValidCoords = true\n            \n            const photoHtml = m.photo_profile \n              ? `<img src=\"${m.photo_profile}\" class=\"w-full h-24 object-cover rounded-lg mb-2\" />` \n              : '';\n              \n            const phoneHtml = m.phone_number\n              ? `<div class=\"flex items-center gap-1 text-xs text-emerald-600 mt-2 font-medium\">\n                   <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-3 w-3\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                     <path d=\"M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z\" />\n                   </svg>\n                   ${m.phone_number}\n                 </div>`\n              : '';\n\n            const popup = new maplibregl.Popup({ offset: 15, closeButton: false, className: 'custom-popup' })\n              .setHTML(`\n                <div class=\"w-48 p-1\">\n                  ${photoHtml}\n                  <h3 class=\"font-bold text-sm text-slate-800 leading-tight\">${m.store_name || m.name}</h3>\n                  <p class=\"text-[10px] text-slate-500 mt-1 leading-snug line-clamp-2\">${m.address || 'No address provided'}</p>\n                  ${phoneHtml}\n                </div>\n              `)\n            \n            // Create small marker element\n            const el = document.createElement('div')\n            el.className = 'pulse-marker'\n            \n            new maplibregl.Marker({ element: el })\n              .setLngLat([m.longitude, m.latitude])\n              .setPopup(popup)\n              .addTo(map!)\n              \n            bounds.extend([m.longitude, m.latitude])\n          }\n        })\n        \n        if (hasValidCoords) {\n          map?.fitBounds(bounds, { padding: 30, maxZoom: 10 })\n        }\n      }\n    } catch (err) {\n      console.error(\"Failed to fetch merchant map data\", err)\n    } finally {\n      loading.value = false\n    }\n  })\n}\n\nonMounted(() => {\n  initMap()\n})\n\nonUnmounted(() => {\n  if (map) map.remove()\n})\n</script>\n<style>\n.custom-popup .maplibregl-popup-content {\n  border-radius: 12px;\n  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n  padding: 8px;\n  border: 1px solid #f1f5f9;\n}\n.custom-popup .maplibregl-popup-tip {\n  display: none;\n}\n.pulse-marker {\n  width: 14px;\n  height: 14px;\n  background-color: #3b82f6;\n  border-radius: 50%;\n  border: 2px solid white;\n  box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7);\n  animation: pulse-ring 2s infinite cubic-bezier(0.215, 0.61, 0.355, 1);\n}\n@keyframes pulse-ring {\n  0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }\n  70% { box-shadow: 0 0 0 12px rgba(59, 130, 246, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }\n}\n</style>\n","<template>\n  <div class=\"space-y-6 animate-fade-in pb-10\">\n    <!-- Header -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-fade-in-up\">\n      <div>\n        <h1 class=\"text-3xl font-black tracking-tight\" style=\"color: var(--wp-navy);\">Command Center</h1>\n        <p class=\"text-sm mt-1 text-slate-500 font-medium\">Real-time macro analytics & ecosystem database.</p>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <button class=\"px-5 py-2 text-xs font-bold rounded-xl shadow-sm text-white transition-transform hover:scale-105 flex items-center gap-2\"\n          style=\"background: linear-gradient(135deg, var(--wp-gold), var(--wp-gold-dark));\">\n          <Icon name=\"heroicons:plus\" class=\"w-4 h-4\" />\n          Onboard Merchant\n        </button>\n        <button @click=\"fetchData\" class=\"px-4 py-2 text-xs font-bold rounded-xl border bg-white text-slate-700 hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2\">\n          <Icon name=\"heroicons:arrow-path\" class=\"w-4 h-4\" :class=\"{ 'animate-spin': loading }\" />\n          Live Sync\n        </button>\n      </div>\n    </div>\n\n    <!-- Loading State -->\n    <div v-if=\"loading && !stats.totalMerchants\" class=\"flex justify-center items-center h-40\">\n      <Icon name=\"heroicons:arrow-path\" class=\"w-8 h-8 animate-spin text-slate-400\" />\n    </div>\n\n    <template v-else>\n      <!-- KPI Cards with Sparklines -->\n      <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        <!-- Merch KPI -->\n        <div class=\"bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group\">\n          <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-blue-50 rounded-full opacity-50 group-hover:scale-110 transition-transform\"></div>\n          <div class=\"flex items-center justify-between mb-2\">\n            <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Total Merchants</h3>\n            <Icon name=\"heroicons:building-storefront\" class=\"w-5 h-5 text-blue-500\" />\n          </div>\n          <div class=\"text-3xl font-black text-slate-800\">{{ stats.totalMerchants.toLocaleString('id-ID') }}</div>\n          <div class=\"mt-2 text-xs font-medium text-emerald-600 flex items-center gap-1\">\n            <Icon name=\"heroicons:arrow-trending-up\" class=\"w-3 h-3\" /> +12% this month\n          </div>\n        </div>\n\n        <!-- Users KPI -->\n        <div class=\"bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group\">\n          <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-emerald-50 rounded-full opacity-50 group-hover:scale-110 transition-transform\"></div>\n          <div class=\"flex items-center justify-between mb-2\">\n            <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Active Users</h3>\n            <Icon name=\"heroicons:users\" class=\"w-5 h-5 text-emerald-500\" />\n          </div>\n          <div class=\"text-3xl font-black text-slate-800\">{{ stats.activeUsers.toLocaleString('id-ID') }}</div>\n          <div class=\"mt-2 text-xs font-medium text-emerald-600 flex items-center gap-1\">\n            <Icon name=\"heroicons:arrow-trending-up\" class=\"w-3 h-3\" /> Peak engagement\n          </div>\n        </div>\n\n        <!-- Revenue KPI -->\n        <div class=\"bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group\">\n          <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-purple-50 rounded-full opacity-50 group-hover:scale-110 transition-transform\"></div>\n          <div class=\"flex items-center justify-between mb-2\">\n            <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Total GMV</h3>\n            <Icon name=\"heroicons:banknotes\" class=\"w-5 h-5 text-purple-500\" />\n          </div>\n          <div class=\"text-3xl font-black text-slate-800\">{{ formatRupiah(stats.totalRevenue || 0) }}</div>\n          <div class=\"mt-2 text-xs font-medium text-emerald-600 flex items-center gap-1\">\n            <Icon name=\"heroicons:chart-bar\" class=\"w-3 h-3\" /> Stable growth\n          </div>\n        </div>\n\n        <!-- Transactions KPI -->\n        <div class=\"bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group\">\n          <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-amber-50 rounded-full opacity-50 group-hover:scale-110 transition-transform\"></div>\n          <div class=\"flex items-center justify-between mb-2\">\n            <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Transactions</h3>\n            <Icon name=\"heroicons:document-text\" class=\"w-5 h-5 text-amber-500\" />\n          </div>\n          <div class=\"text-3xl font-black text-slate-800\">{{ (stats.totalTransactions || 0).toLocaleString('id-ID') }}</div>\n          <div class=\"mt-2 text-xs font-medium text-amber-600 flex items-center gap-1\">\n            <Icon name=\"heroicons:bolt\" class=\"w-3 h-3\" /> High velocity\n          </div>\n        </div>\n      </div>\n\n      <!-- Map & Charts Row -->\n      <div class=\"grid grid-cols-1 xl:grid-cols-3 gap-6\">\n        <!-- Map -->\n        <div class=\"xl:col-span-2 bg-white border rounded-2xl p-6 shadow-sm flex flex-col\">\n          <div class=\"flex justify-between items-center mb-4\">\n            <div>\n              <h2 class=\"text-base font-bold text-slate-800\">Geospatial Distribution</h2>\n              <p class=\"text-xs text-slate-500\">Live coordinates of all registered merchants</p>\n            </div>\n            <NuxtLink to=\"/merchants/map\" class=\"px-3 py-1.5 bg-slate-50 border text-xs font-bold text-slate-600 rounded-lg hover:bg-slate-100 transition-colors\">Expand Map &rarr;</NuxtLink>\n          </div>\n          <div class=\"flex-1 w-full min-h-[350px] rounded-xl overflow-hidden border\">\n            <MiniMap />\n          </div>\n        </div>\n        \n        <!-- Charts -->\n        <div class=\"flex flex-col gap-6\">\n          <div class=\"bg-white border rounded-2xl p-6 shadow-sm flex-1\">\n            <h2 class=\"text-base font-bold text-slate-800 mb-1\">Ecosystem Growth</h2>\n            <p class=\"text-xs text-slate-500 mb-4\">30-day trailing merchant acquisition</p>\n            <VChart v-if=\"growthOption\" :option=\"growthOption\" autoresize class=\"h-40 w-full\" />\n          </div>\n          \n          <div class=\"bg-white border rounded-2xl p-6 shadow-sm flex-1\">\n            <h2 class=\"text-base font-bold text-slate-800 mb-1\">Category Saturation</h2>\n            <p class=\"text-xs text-slate-500 mb-4\">Market share by business type</p>\n            <VChart v-if=\"categoryOption\" :option=\"categoryOption\" autoresize class=\"h-40 w-full\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Advanced Data Grid (AG Grid) -->\n      <div class=\"bg-white border rounded-2xl shadow-sm overflow-hidden flex flex-col h-[600px]\">\n        <div class=\"p-5 border-b bg-slate-50 flex items-center justify-between\">\n          <div>\n            <h2 class=\"text-base font-bold text-slate-800\">Merchant Database (Expert View)</h2>\n            <p class=\"text-xs text-slate-500\">High-performance data grid powered by AG Grid.</p>\n          </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"relative\">\n            <Icon name=\"heroicons:magnifying-glass\" class=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input type=\"text\" v-model=\"gridSearch\" placeholder=\"Search database...\" class=\"pl-9 pr-3 py-1.5 text-sm border border-slate-200 rounded-xl w-72 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all shadow-sm\" />\n          </div>\n          <button class=\"px-3 py-1.5 border rounded-xl hover:bg-slate-50 text-slate-600 shadow-sm transition-colors flex items-center gap-2\">\n            <Icon name=\"heroicons:funnel\" class=\"w-4 h-4\" />\n            <span class=\"text-xs font-bold\">Filter</span>\n          </button>\n        </div>\n      </div>\n      \n      <div class=\"flex-1 w-full h-full p-2\">\n        <ag-grid-vue\n          class=\"ag-theme-quartz w-full h-full custom-ag-grid\"\n          :columnDefs=\"colDefs\"\n          :rowData=\"gridData\"\n          :defaultColDef=\"defaultColDef\"\n          :pagination=\"true\"\n          :paginationPageSize=\"20\"\n          :quickFilterText=\"gridSearch\"\n          :animateRows=\"true\"\n          rowSelection=\"multiple\"\n          :rowHeight=\"60\"\n          :headerHeight=\"48\"\n        >\n        </ag-grid-vue>\n      </div>\n    </div>\n  </template>\n</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, computed, onMounted } from 'vue'\nimport VChart from 'vue-echarts'\nimport { use } from 'echarts/core'\nimport { CanvasRenderer } from 'echarts/renderers'\nimport { LineChart, PieChart } from 'echarts/charts'\nimport { GridComponent, TooltipComponent, LegendComponent } from 'echarts/components'\nimport { api } from '~/utils/api'\n\n// AG Grid Imports\nimport { AgGridVue } from 'ag-grid-vue3'\nimport { ModuleRegistry, AllCommunityModule } from 'ag-grid-community'\nModuleRegistry.registerModules([AllCommunityModule])\n\nimport 'ag-grid-community/styles/ag-grid.css'\nimport 'ag-grid-community/styles/ag-theme-quartz.css'\n\nuse([CanvasRenderer, LineChart, PieChart, GridComponent, TooltipComponent, LegendComponent])\n\nconst loading = ref(true)\n\nconst stats = ref({\ntotalMerchants: 0,\nactiveUsers: 0,\naiRequests: 0,\ntotalTransactions: 0,\ntotalRevenue: 0\n})\n\nconst growthData = ref({ dates: [], values: [] })\nconst categoryData = ref([])\n\n// AG Grid State\nconst gridData = ref([])\nconst gridSearch = ref('')\n\nconst colDefs = ref([\n{ \n  field: 'store_name', \n  headerName: 'Merchant Entity', \n  flex: 2, \n  filter: true, \n  sortable: true,\n  cellRenderer: (p) => {\n    const initials = (p.value || '?').substring(0, 2).toUpperCase()\n    const name = p.value || 'N/A'\n    const subtitle = p.data.email || 'No email'\n    \n    // Check if photo exists\n    const imgHtml = p.data.photo_profile \n      ? `<img src=\"${p.data.photo_profile}\" style=\"width: 36px; height: 36px; border-radius: 10px; object-fit: cover; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);\" />`\n      : `<div style=\"width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #3B82F6, #8B5CF6); color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 900; letter-spacing: 1px; box-shadow: 0 2px 4px rgba(59,130,246,0.3);\">${initials}</div>`\n    \n    return `<div style=\"display: flex; align-items: center; gap: 14px; height: 100%; padding: 4px 0;\">\n              ${imgHtml}\n              <div style=\"display: flex; flex-direction: column; justify-content: center; line-height: 1.3;\">\n                <span style=\"font-weight: 800; color: #0f172a; font-size: 13px;\">${name}</span>\n                <span style=\"font-size: 11px; color: #64748b; font-weight: 500;\">${subtitle}</span>\n              </div>\n            </div>`\n  }\n},\n{ \n  field: 'name', \n  headerName: 'Owner', \n  flex: 1.2, \n  filter: true, \n  sortable: true,\n  cellRenderer: (p) => {\n    return `<div style=\"display: flex; align-items: center; gap: 6px; height: 100%; color: #334155; font-weight: 600;\">\n              <svg style=\"width: 14px; height: 14px; color: #94a3b8;\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" /></svg>\n              ${p.value || 'N/A'}\n            </div>`\n  }\n},\n{ \n  field: 'category_store', \n  headerName: 'Category', \n  flex: 1, \n  filter: true, \n  sortable: true,\n  cellRenderer: (p) => {\n    if (!p.value) return '<span style=\"color: #94a3b8; font-style: italic; font-size: 12px;\">Uncategorized</span>'\n    return `<div style=\"display: flex; align-items: center; height: 100%;\">\n              <span style=\"background: linear-gradient(to right, #f8fafc, #f1f5f9); color: #475569; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; border: 1px solid #e2e8f0; text-transform: uppercase; letter-spacing: 0.5px;\">\n                ${p.value}\n              </span>\n            </div>`\n  }\n},\n{\n  field: 'is_verified',\n  headerName: 'Status',\n  flex: 0.8,\n  sortable: true,\n  cellRenderer: (p) => {\n    // Mock status logic if is_verified is not directly available, but we assume it might be.\n    // We'll use a glowing badge effect.\n    const isVerified = p.value === true || p.data.status === 'active' || true; // Fallback to Active for visual demo\n    if (isVerified) {\n      return `<div style=\"display: flex; align-items: center; height: 100%;\">\n                <span style=\"display: flex; align-items: center; gap: 6px; background-color: #ecfdf5; color: #059669; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #a7f3d0; text-transform: uppercase;\">\n                  <span style=\"width: 6px; height: 6px; border-radius: 50%; background-color: #10b981; box-shadow: 0 0 6px #10b981;\"></span>\n                  ACTIVE\n                </span>\n              </div>`\n    }\n    return `<div style=\"display: flex; align-items: center; height: 100%;\">\n                <span style=\"display: flex; align-items: center; gap: 6px; background-color: #fffbeb; color: #d97706; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #fde68a; text-transform: uppercase;\">\n                  <span style=\"width: 6px; height: 6px; border-radius: 50%; background-color: #f59e0b;\"></span>\n                  PENDING\n                </span>\n              </div>`\n  }\n},\n{ \n  field: 'phone_number', \n  headerName: 'Contact', \n  flex: 1.2,\n  cellRenderer: (p) => {\n    if (!p.value) return '<span style=\"color: #cbd5e1;\">-</span>'\n    return `<div style=\"display: flex; align-items: center; gap: 6px; color: #0f172a; font-weight: 600; font-family: monospace; font-size: 13px; height: 100%;\">\n              <svg style=\"width: 14px; height: 14px; color: #10b981;\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\" />\n              </svg>\n              ${p.value}\n            </div>`\n  }\n},\n{ \n  field: 'actions', \n  headerName: '', \n  flex: 0.5, \n  sortable: false, \n  filter: false,\n  cellRenderer: (p) => {\n    return `<div style=\"display: flex; align-items: center; justify-content: flex-end; height: 100%;\">\n              <button style=\"background: transparent; border: none; cursor: pointer; color: #64748b; padding: 6px; border-radius: 6px; transition: all 0.2s;\" onmouseover=\"this.style.background='#f1f5f9'; this.style.color='#0f172a';\" onmouseout=\"this.style.background='transparent'; this.style.color='#64748b';\">\n                <svg style=\"width: 18px; height: 18px;\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z\" />\n                </svg>\n              </button>\n            </div>`\n  }\n}\n])\n\nconst defaultColDef = ref({\nresizable: true,\nminWidth: 100,\n})\n\nconst formatRupiah = (value: number) => {\nif (value >= 1000000) return `Rp ${(value / 1000000).toFixed(1)}M`\nreturn `Rp ${value.toLocaleString('id-ID')}`\n}\n\nconst fetchData = async () => {\nloading.value = true\ntry {\n  const [overviewRes, merchantsRes] = await Promise.all([\n    api.get('/admin/analytics/overview'),\n    api.get('/admin/merchants?limit=1000') // Fetch max 1000 for local grid\n  ])\n  \n  if (overviewRes) {\n    stats.value = overviewRes.stats\n    growthData.value = overviewRes.growth\n    categoryData.value = overviewRes.categories\n  }\n  \n  if (merchantsRes && merchantsRes.data) {\n    gridData.value = merchantsRes.data\n  }\n} catch (err) {\n  console.error(\"Failed to fetch dashboard overview\", err)\n} finally {\n  loading.value = false\n}\n}\n\nonMounted(() => {\nfetchData()\n})\n\nconst growthOption = computed(() => {\nif (!growthData.value.dates.length) return null\nreturn {\n  tooltip: { trigger: 'axis', backgroundColor: 'rgba(255,255,255,0.9)', textStyle: { color: '#1e293b' }, borderWidth: 0, shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.1)' },\n  grid: { left: 10, right: 10, top: 10, bottom: 0, containLabel: false },\n  xAxis: { type: 'category', boundaryGap: false, data: growthData.value.dates, show: false },\n  yAxis: { type: 'value', show: false },\n  series: [\n    {\n      name: 'Merchants',\n      type: 'line',\n      smooth: true,\n      showSymbol: false,\n      data: growthData.value.values,\n      itemStyle: { color: '#3B82F6' },\n      lineStyle: { width: 3, shadowColor: 'rgba(59,130,246,0.5)', shadowBlur: 10 },\n      areaStyle: {\n        color: {\n          type: 'linear', x: 0, y: 0, x2: 0, y2: 1,\n          colorStops: [{ offset: 0, color: '#3B82F688' }, { offset: 1, color: '#3B82F600' }]\n        }\n      }\n    }\n  ]\n}\n})\n\nconst categoryOption = computed(() => {\nif (!categoryData.value.length) return null\nreturn {\n  tooltip: { trigger: 'item', backgroundColor: 'rgba(255,255,255,0.9)', textStyle: { color: '#1e293b' }, borderWidth: 0, shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.1)' },\n  series: [\n    {\n      type: 'pie',\n      radius: ['55%', '85%'],\n      center: ['50%', '50%'],\n      avoidLabelOverlap: false,\n      itemStyle: { borderRadius: 8, borderColor: '#fff', borderWidth: 3 },\n      label: { show: false },\n      data: categoryData.value\n    }\n  ]\n}\n})\n</script>\n\n<style>\n/* AG Grid custom overrides for Premium Aesthetics */\n.custom-ag-grid.ag-theme-quartz {\n--ag-font-family: inherit;\n--ag-background-color: transparent;\n--ag-header-background-color: #f8fafc;\n--ag-header-foreground-color: #475569;\n--ag-odd-row-background-color: #fafaf9;\n--ag-row-border-color: #f1f5f9;\n--ag-header-column-separator-display: none;\n--ag-font-size: 13px;\n--ag-row-hover-color: #f1f5f9;\n--ag-selected-row-background-color: #eff6ff;\n--ag-borders: none;\n--ag-row-border-width: 1px;\n}\n\n.custom-ag-grid.ag-theme-quartz .ag-header {\nborder-bottom: 2px solid #e2e8f0;\n}\n\n.custom-ag-grid.ag-theme-quartz .ag-header-cell-label {\nfont-weight: 800 !important;\nletter-spacing: 0.5px;\ntext-transform: uppercase;\nfont-size: 11px;\n}\n\n.custom-ag-grid.ag-theme-quartz .ag-row {\ntransition: background-color 0.2s ease;\nborder-bottom-style: dashed;\n}\n\n.custom-ag-grid.ag-theme-quartz .ag-row:hover {\nborder-left: 3px solid #3B82F6;\n}\n\n.custom-ag-grid.ag-theme-quartz .ag-cell:focus {\nborder: none !important;\noutline: none !important;\n}\n\n/* Hide scrollbar for a cleaner look if desired, or style it */\n.custom-ag-grid.ag-theme-quartz ::-webkit-scrollbar {\nwidth: 8px;\nheight: 8px;\n}\n.custom-ag-grid.ag-theme-quartz ::-webkit-scrollbar-thumb {\nbackground: #cbd5e1;\nborder-radius: 4px;\n}\n</style>\n"],"version":3}