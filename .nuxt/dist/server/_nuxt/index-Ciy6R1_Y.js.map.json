AW,CAAC,MAAc,KAAK,MAAU,IAAI,IAAE,KAAS,QAAQ,CAAC,CAAC,MAAM,IAAE;AAAA,QAC/G,OAAO,EAAE,MAAM,YAAY,MAAM,MAAM,IAAI,CAAC,MAAW,EAAE,IAAI,GAAG,WAAW,EAAE,OAAO,KAAK,UAAU,aAAW;AAAA,QAC9G,QAAQ;AAAA,UACN;AAAA,YACE,MAAM;AAAA,YACN,MAAM;AAAA,YACN,MAAM,MAAM,IAAI,CAAC,MAAW,EAAE,OAAO;AAAA,YACrC,WAAW,EAAE,OAAO,WAAW,cAAc,CAAC,GAAG,GAAG,GAAG,CAAC,EAAA;AAAA,UAAE;AAAA,QAC5D;AAAA,MACF;AAAA,IAEJ,CAAC;AAED,UAAM,iBAAiB,SAAS,MAAM;AACpC,UAAI,CAAC,KAAK,MAAO,QAAO;AACxB,aAAO;AAAA,QACL,SAAS,EAAE,SAAS,OAAA;AAAA,QACpB,QAAQ,EAAE,QAAQ,GAAG,MAAM,SAAA;AAAA,QAC3B,QAAQ;AAAA,UACN;AAAA,YACE,MAAM;AAAA,YACN,QAAQ,CAAC,OAAO,KAAK;AAAA,YACrB,QAAQ,CAAC,OAAO,KAAK;AAAA,YACrB,mBAAmB;AAAA,YACnB,WAAW,EAAE,cAAc,IAAI,aAAa,QAAQ,aAAa,EAAA;AAAA,YACjE,OAAO,EAAE,MAAM,MAAA;AAAA,YACf,MAAM,KAAK,MAAM,OAAO;AAAA,UAAA;AAAA,QAC1B;AAAA,MACF;AAAA,IAEJ,CAAC;;;;;AA3PM,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,+BAA2B,MAAA,CAAA,CAAA,ytBAAA;;QAkBxB,IAAG;AAAA,QAAa,OAAM;AAAA,MAAA;yBAAhC,CAA4I,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAAnB,UAAQ;AAAA,YAAA;AAAA;;;;;QACvH,IAAG;AAAA,QAAqB,OAAM;AAAA,MAAA;yBAAxC,CAAgJ,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA,YAAA;AAAA;;;;;QAC3H,IAAG;AAAA,QAAuB,OAAM;AAAA,MAAA;yBAA1C,CAAoJ,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAApB,WAAS;AAAA,YAAA;AAAA;;;;;QAC/H,IAAG;AAAA,QAAsB,OAAM;AAAA,MAAA;yBAAzC,CAAoJ,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAArB,YAAU;AAAA,YAAA;AAAA;;;;;QAC/H,IAAG;AAAA,QAAqB,OAAM;AAAA,MAAA;yBAAxC,CAAyJ,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAA3B,kBAAgB;AAAA,YAAA;AAAA;;;;;QACpI,IAAG;AAAA,QAAqB,OAAM;AAAA,MAAA;yBAAxC,CAAgJ,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA,YAAA;AAAA;;;;;UAG5H,QAAA,OAAO;;;UACV,MAAK;AAAA,UAAuB,OAAM;AAAA,QAAA;;;;;UAM7B,OAAM;AAAA,UAAe,OAAO,aAAa,WAAK,IAAI,YAAY;AAAA,UAAG,MAAK;AAAA,UAAsB,QAAO;AAAA,QAAA;;UACnG,OAAM;AAAA,UAAmB,OAAO,KAAA,MAAK,IAAI,kBAAkB,eAAc,OAAA;AAAA,UAAW,MAAK;AAAA,UAA4B,QAAO;AAAA,QAAA;;UAC5H,OAAM;AAAA,UAAkB,OAAO,aAAa,WAAK,IAAI,kBAAkB;AAAA,UAAG,MAAK;AAAA,UAAsB,QAAO;AAAA,QAAA;;UAC5G,OAAM;AAAA,UAAgB,OAAO,KAAA,MAAK,IAAI,cAAc,eAAc,OAAA;AAAA,UAAW,MAAK;AAAA,UAAiB,QAAO;AAAA,QAAA;;UAC1G,OAAM;AAAA,UAAgB,OAAK,IAAM,KAAA,MAAK,IAAI,SAAS;AAAA,UAAK,MAAK;AAAA,UAA8B,QAAO;AAAA,QAAA;;YAQ3F,cAAA,OAAa;;YAAG,QAAQ,cAAA;AAAA,YAAe,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;YAMxD,SAAA,OAAQ;;YAAG,QAAQ,SAAA;AAAA,YAAU,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;YAS9C,mBAAA,OAAkB;;YAAG,QAAQ,mBAAA;AAAA,YAAoB,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;YAMlE,eAAA,OAAc;;YAAG,QAAQ,eAAA;AAAA,YAAgB,YAAA;AAAA,YAAW,OAAM;AAAA,UAAA;;;;;AAmBzD,YAAA,CAAA,KAAA,MAAK,OAAO,iBAAiB,QAAM;;;;;;AAGzBC,sBAAA,KAAA,MAAK,OAAO,kBAAgB,CAArC,GAAG,MAAC;uLACsDC,eAAA,EAAE,IAAI,0EAC/B,EAAA,SAAA,iBAAA,CAA8B,MAAIA,eAAA,EAAE,IAAI;;;;UAU7E,IAAG;AAAA,UAAoB,OAAM;AAAA,UAAoB,OAAA,EAAA,SAAA,sBAAA;AAAA,QAAA;2BAA3D,CAAkH,GAAAH,QAAAC,UAAA,aAAA;;;;;gCAAnB,UAAQ;AAAA,cAAA;AAAA;;;;;AAW1F,YAAA,CAAA,KAAA,MAAK,OAAO,UAAU,QAAM;;;;;;AAGjBC,sBAAA,KAAA,MAAK,OAAO,WAAS,CAA/B,IAAI,MAAC;uLACqDC,eAAA,GAAG,OAAO,+DACrBA,eAAA,GAAG,KAAK,iEACNA,eAAA,GAAG,KAAK;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrRenderList","_ssrInterpolate"],"sources":["../../../../pages/analytics/index.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6 animate-fade-in\">\n    <!-- Header with Tabs -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n      <div>\n        <h1 class=\"text-2xl font-extrabold tracking-tight text-slate-800\">Analytics Center</h1>\n        <p class=\"text-sm mt-1 text-slate-500\">Comprehensive insights into platform performance.</p>\n      </div>\n      \n      <!-- Date Filter (Mock UI) -->\n      <div class=\"flex items-center gap-2 bg-white border p-1 rounded-xl shadow-sm\">\n        <button class=\"px-3 py-1.5 text-xs font-bold bg-blue-50 text-blue-600 rounded-lg\">30 Days</button>\n        <button class=\"px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700\">90 Days</button>\n        <button class=\"px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700\">All Time</button>\n      </div>\n    </div>\n\n    <!-- Navigation Tabs -->\n    <div class=\"flex items-center gap-2 overflow-x-auto pb-2 border-b\">\n      <NuxtLink to=\"/analytics\" class=\"px-4 py-2 text-sm font-bold border-b-2 border-blue-600 text-blue-600 whitespace-nowrap\">Overview</NuxtLink>\n      <NuxtLink to=\"/analytics/finance\" class=\"px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-800 whitespace-nowrap\">Finance</NuxtLink>\n      <NuxtLink to=\"/analytics/merchants\" class=\"px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-800 whitespace-nowrap\">Merchants</NuxtLink>\n      <NuxtLink to=\"/analytics/ai-usage\" class=\"px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-800 whitespace-nowrap\">AI & Usage</NuxtLink>\n      <NuxtLink to=\"/analytics/catalog\" class=\"px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-800 whitespace-nowrap\">Catalog Insights</NuxtLink>\n      <NuxtLink to=\"/analytics/reports\" class=\"px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-800 whitespace-nowrap\">Reports</NuxtLink>\n    </div>\n\n    <div v-if=\"loading\" class=\"flex justify-center py-20\">\n      <Icon name=\"heroicons:arrow-path\" class=\"w-8 h-8 animate-spin text-slate-400\" />\n    </div>\n\n    <template v-else>\n      <!-- Global KPIs -->\n      <div class=\"grid grid-cols-2 lg:grid-cols-5 gap-4\">\n        <KpiCard title=\"Total Omzet\" :value=\"formatRupiah(data.kpi.totalRevenue)\" icon=\"heroicons:banknotes\" accent=\"#3B82F6\" />\n        <KpiCard title=\"Total Transaksi\" :value=\"data.kpi.totalTransactions.toLocaleString('id-ID')\" icon=\"heroicons:receipt-percent\" accent=\"#10B981\" />\n        <KpiCard title=\"Avg Omzet/Toko\" :value=\"formatRupiah(data.kpi.avgRevenuePerStore)\" icon=\"heroicons:chart-bar\" accent=\"#F59E0B\" />\n        <KpiCard title=\"Total Produk\" :value=\"data.kpi.totalProducts.toLocaleString('id-ID')\" icon=\"heroicons:cube\" accent=\"#8B5CF6\" />\n        <KpiCard title=\"Growth (MoM)\" :value=\"`+${data.kpi.growthMoM}%`\" icon=\"heroicons:arrow-trending-up\" accent=\"#EC4899\" />\n      </div>\n\n      <!-- Main Charts Row -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <!-- Revenue Trend Line Chart -->\n        <div class=\"bg-white border border-[var(--wp-border)] rounded-sm p-6 shadow-sm\">\n          <h2 class=\"text-base font-bold mb-4 text-[var(--wp-navy)]\">Platform Revenue Trend</h2>\n          <VChart v-if=\"revenueOption\" :option=\"revenueOption\" autoresize class=\"h-72 w-full\" />\n        </div>\n        \n        <!-- AI Activity Area Chart -->\n        <div class=\"bg-white border border-[var(--wp-border)] rounded-sm p-6 shadow-sm\">\n          <h2 class=\"text-base font-bold mb-4 text-[var(--wp-navy)]\">AI Chat Activity</h2>\n          <VChart v-if=\"aiOption\" :option=\"aiOption\" autoresize class=\"h-72 w-full\" />\n        </div>\n      </div>\n\n      <!-- Secondary Charts & Tables Row -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <!-- Top 10 Merchants Bar Chart -->\n        <div class=\"lg:col-span-2 bg-white border border-[var(--wp-border)] rounded-sm p-6 shadow-sm\">\n          <h2 class=\"text-base font-bold mb-4 text-[var(--wp-navy)]\">Top 10 Merchants (by Revenue)</h2>\n          <VChart v-if=\"topMerchantsOption\" :option=\"topMerchantsOption\" autoresize class=\"h-72 w-full\" />\n        </div>\n\n        <!-- Category Distribution Pie Chart -->\n        <div class=\"bg-white border border-[var(--wp-border)] rounded-sm p-6 shadow-sm\">\n          <h2 class=\"text-base font-bold mb-4 text-[var(--wp-navy)]\">Category Distribution</h2>\n          <VChart v-if=\"categoryOption\" :option=\"categoryOption\" autoresize class=\"h-72 w-full\" />\n        </div>\n      </div>\n\n      <!-- Tables Row -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <!-- Trending Products -->\n        <div class=\"bg-white border border-[var(--wp-border)] rounded-sm shadow-sm overflow-hidden flex flex-col\">\n          <div class=\"p-4 border-b border-[var(--wp-border)] bg-slate-50/50\">\n            <h2 class=\"text-sm font-bold text-[var(--wp-navy)]\">Trending Products</h2>\n          </div>\n          <table class=\"w-full text-left text-sm text-slate-600 table-fixed\">\n            <thead class=\"bg-slate-50 text-[10px] uppercase text-slate-500 font-bold border-b border-[var(--wp-border)] tracking-wider\">\n              <tr>\n                <th class=\"px-5 py-3 w-3/4\">Product Name</th>\n                <th class=\"px-5 py-3 w-1/4 text-right\">Qty Sold</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr v-if=\"!data.tables.trendingProducts.length\">\n                <td colspan=\"2\" class=\"px-5 py-8 text-center text-slate-400\">No data available</td>\n              </tr>\n              <tr v-for=\"(p, i) in data.tables.trendingProducts\" :key=\"i\" class=\"border-b border-[var(--wp-border)] last:border-b-0 hover:bg-slate-50 transition-colors\">\n                <td class=\"px-5 py-3 font-medium text-[var(--wp-navy)] truncate\">{{ p.name }}</td>\n                <td class=\"px-5 py-3 text-right font-bold\" style=\"color: var(--wp-navy);\">{{ p.sold }}</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <!-- Low Stock Alerts Global -->\n        <div class=\"bg-white border border-[var(--wp-border)] rounded-sm shadow-sm overflow-hidden flex flex-col\">\n          <div class=\"p-4 border-b border-[var(--wp-border)] bg-slate-50/50 flex justify-between items-center\">\n            <h2 class=\"text-sm font-bold text-[var(--wp-navy)]\">Global Low Stock Alerts</h2>\n            <NuxtLink to=\"/analytics/stocks\" class=\"text-xs font-bold\" style=\"color: var(--wp-gold-dark);\">View All</NuxtLink>\n          </div>\n          <table class=\"w-full text-left text-sm text-slate-600 table-fixed\">\n            <thead class=\"bg-slate-50 text-[10px] uppercase text-slate-500 font-bold border-b border-[var(--wp-border)] tracking-wider\">\n              <tr>\n                <th class=\"px-5 py-3 w-2/5\">Product</th>\n                <th class=\"px-5 py-3 w-2/5\">Merchant</th>\n                <th class=\"px-5 py-3 w-1/5 text-right\">Stock</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr v-if=\"!data.tables.lowStocks.length\">\n                <td colspan=\"3\" class=\"px-5 py-8 text-center text-slate-400\">All stocks are healthy!</td>\n              </tr>\n              <tr v-for=\"(ls, i) in data.tables.lowStocks\" :key=\"i\" class=\"border-b border-[var(--wp-border)] last:border-b-0 hover:bg-slate-50 transition-colors\">\n                <td class=\"px-5 py-3 font-medium text-[var(--wp-navy)] truncate\">{{ ls.product }}</td>\n                <td class=\"px-5 py-3 text-xs text-slate-500 truncate\">{{ ls.store }}</td>\n                <td class=\"px-5 py-3 text-right font-bold text-red-600\">{{ ls.stock }}</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </template>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, computed, onMounted } from 'vue'\nimport VChart from 'vue-echarts'\nimport { use } from 'echarts/core'\nimport { CanvasRenderer } from 'echarts/renderers'\nimport { LineChart, BarChart, PieChart } from 'echarts/charts'\nimport { GridComponent, TooltipComponent, LegendComponent } from 'echarts/components'\nimport { api } from '~/utils/api'\n\nuse([CanvasRenderer, LineChart, BarChart, PieChart, GridComponent, TooltipComponent, LegendComponent])\n\nconst loading = ref(true)\nconst data = ref<any>(null)\n\nconst formatRupiah = (value: number) => {\n  if (!value) return 'Rp 0'\n  if (value >= 1000000) return `Rp ${(value / 1000000).toFixed(1)}M`\n  return `Rp ${value.toLocaleString('id-ID')}`\n}\n\nconst fetchData = async () => {\n  loading.value = true\n  try {\n    const res = await api.get('/admin/analytics/deep-overview')\n    if (res) {\n      data.value = res\n    }\n  } catch (err) {\n    console.error(\"Failed to fetch analytics\", err)\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(() => {\n  fetchData()\n})\n\nconst revenueOption = computed(() => {\n  if (!data.value) return null\n  return {\n    tooltip: { trigger: 'axis', formatter: '{b}<br/>{a}: Rp {c}' },\n    grid: { left: 50, right: 20, top: 20, bottom: 20 },\n    xAxis: { type: 'category', boundaryGap: false, data: data.value.charts.revenueTrend.dates },\n    yAxis: { type: 'value', axisLabel: { formatter: (v: number) => v >= 1000000 ? `${(v/1000000).toFixed(1)}M` : v } },\n    series: [\n      {\n        name: 'Revenue',\n        type: 'line',\n        smooth: true,\n        data: data.value.charts.revenueTrend.values,\n        itemStyle: { color: '#10B981' },\n        areaStyle: {\n          color: {\n            type: 'linear', x: 0, y: 0, x2: 0, y2: 1,\n            colorStops: [{ offset: 0, color: '#10B98144' }, { offset: 1, color: '#10B98100' }]\n          }\n        }\n      }\n    ]\n  }\n})\n\nconst aiOption = computed(() => {\n  if (!data.value) return null\n  return {\n    tooltip: { trigger: 'axis' },\n    grid: { left: 40, right: 20, top: 20, bottom: 20 },\n    xAxis: { type: 'category', boundaryGap: false, data: data.value.charts.aiActivity.dates },\n    yAxis: { type: 'value' },\n    series: [\n      {\n        name: 'AI Requests',\n        type: 'line',\n        smooth: true,\n        data: data.value.charts.aiActivity.values,\n        itemStyle: { color: '#8B5CF6' },\n        areaStyle: {\n          color: {\n            type: 'linear', x: 0, y: 0, x2: 0, y2: 1,\n            colorStops: [{ offset: 0, color: '#8B5CF644' }, { offset: 1, color: '#8B5CF600' }]\n          }\n        }\n      }\n    ]\n  }\n})\n\nconst topMerchantsOption = computed(() => {\n  if (!data.value) return null\n  const items = data.value.charts.topMerchants.slice().reverse()\n  return {\n    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },\n    grid: { left: 120, right: 20, top: 20, bottom: 20 },\n    xAxis: { type: 'value', axisLabel: { formatter: (v: number) => v >= 1000000 ? `${(v/1000000).toFixed(1)}M` : v } },\n    yAxis: { type: 'category', data: items.map((i: any) => i.name), axisLabel: { width: 100, overflow: 'truncate' } },\n    series: [\n      {\n        name: 'Revenue',\n        type: 'bar',\n        data: items.map((i: any) => i.revenue),\n        itemStyle: { color: '#3B82F6', borderRadius: [0, 4, 4, 0] }\n      }\n    ]\n  }\n})\n\nconst categoryOption = computed(() => {\n  if (!data.value) return null\n  return {\n    tooltip: { trigger: 'item' },\n    legend: { bottom: 0, type: 'scroll' },\n    series: [\n      {\n        type: 'pie',\n        radius: ['40%', '70%'],\n        center: ['50%', '45%'],\n        avoidLabelOverlap: false,\n        itemStyle: { borderRadius: 10, borderColor: '#fff', borderWidth: 2 },\n        label: { show: false },\n        data: data.value.charts.categories\n      }\n    ]\n  }\n})\n</script>\n"],"version":3}